<?xml version="1.0" encoding="utf-8"?>
<!--
  HIVA launcher icon foreground — H-in-circle mark
  Viewport 108×108, safe zone is the inner 72×72 (18dp inset each side).
  All artwork kept inside the safe zone so adaptive icon cropping works correctly.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer solid ring (HIVA dark green #155D46) -->
    <path
        android:fillColor="#00000000"
        android:pathData="M54,18 m-34,0 a34,34 0 1,0 68,0 a34,34 0 1,0 -68,0"
        android:strokeColor="#155D46"
        android:strokeWidth="3.5" />

    <!-- Inner accent ring (brand tan #C9A96E) -->
    <path
        android:fillColor="#00000000"
        android:pathData="M54,18 m-27,0 a27,27 0 1,0 54,0 a27,27 0 1,0 -54,0"
        android:strokeColor="#C9A96E"
        android:strokeWidth="1.5"
        android:strokeLineCap="round" />

    <!-- H left vertical stroke -->
    <path
        android:fillColor="#00000000"
        android:pathData="M40,32 L40,76"
        android:strokeColor="#155D46"
        android:strokeWidth="5.5"
        android:strokeLineCap="round" />

    <!-- H right vertical stroke -->
    <path
        android:fillColor="#00000000"
        android:pathData="M68,32 L68,76"
        android:strokeColor="#155D46"
        android:strokeWidth="5.5"
        android:strokeLineCap="round" />

    <!-- H crossbar -->
    <path
        android:fillColor="#00000000"
        android:pathData="M40,54 L68,54"
        android:strokeColor="#155D46"
        android:strokeWidth="5.5"
        android:strokeLineCap="round" />

    <!-- Center accent dot (brand tan) -->
    <path
        android:fillColor="#C9A96E"
        android:pathData="M54,49 a5,5 0 1,0 0.001,0 Z" />

</vector>
