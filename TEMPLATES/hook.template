/**
 * Copy this file, rename it to use[NAME].ts, fill in the [PLACEHOLDERS]
 * 
 * This template is for custom React hooks.
 * Hooks encapsulate reusable logic and state.
 * 
 * Rules from AGENTS.md:
 * - Prefix with 'use'
 * - Return an object or tuple with clear shape
 * - Use useCallback for returned functions
 * - Use useMemo for derived return values
 * - Document return shape in the type
 */

import { useState, useCallback, useMemo, useEffect } from 'react';

// ─── TYPES ───

interface [HOOK_NAME]Options {
  initialValue?: string;
  enabled?: boolean;
}

interface [HOOK_NAME]Return {
  value: string;
  setValue: (value: string) => void;
  isValid: boolean;
  error: string | null;
  reset: () => void;
}

// ─── CONSTANTS ───

const DEFAULT_VALUE = '' as const;

// ─── HOOK ───

export const [HOOK_NAME] = (options: [HOOK_NAME]Options = {}): [HOOK_NAME]Return => {
  const { initialValue = DEFAULT_VALUE, enabled = true } = options;

  const [value, setValue] = useState<string>(initialValue);
  const [error, setError] = useState<string | null>(null);

  // Core logic function
  const validate = useCallback((input: string): boolean => {
    if (!input.trim()) {
      setError('Value is required');
      return false;
    }
    setError(null);
    return true;
  }, []);

  // Wrapper for setValue that validates
  const handleSetValue = useCallback((newValue: string) => {
    setValue(newValue);
    validate(newValue);
  }, [validate]);

  const reset = useCallback(() => {
    setValue(initialValue);
    setError(null);
  }, [initialValue]);

  // Derived state
  const isValid = useMemo(() => error === null && value.trim().length > 0, [error, value]);

  // Side effect (if needed)
  useEffect(() => {
    if (!enabled) return;
    // Effect logic here
    return () => {
      // Cleanup here
    };
  }, [enabled, value]);

  return {
    value,
    setValue: handleSetValue,
    isValid,
    error,
    reset,
  };
};

export default [HOOK_NAME];
