// Only if not already in shared types file

interface [SCREEN_NAME]Props {
  // Screens usually don't take props — they read from router/context
}

// ─── CONSTANTS ───

const PAGE_TRANSITION = {
  initial: { opacity: 0, x: 20 },
  animate: { opacity: 1, x: 0 },
  exit: { opacity: 0, x: -20 },
  transition: { duration: 0.2, ease: [0.4, 0, 0.2, 1] },
} as const;

// ─── SCREEN COMPONENT ───

const [SCREEN_NAME]: React.FC = () => {
  const { navigate, params } = useRouter();
  const { state: authState } = useAuth();

  // Screen-level state
  const [isLoading, setIsLoading] = useState<boolean>(false);
  const [data, setData] = useState<[SCREEN_TYPE] | null>(null);

  // Derived state
  const isReady = useMemo(() => !isLoading && data !== null, [isLoading, data]);

  // Event handlers
  const handleAction = useCallback(() => {
    // Implement action
    navigate('/[ROUTE]');
  }, [navigate]);

  // Side effects (data loading, subscriptions)
  useEffect(() => {
    // Load data or set up listeners
    setIsLoading(true);
    // Simulate or perform synchronous data lookup
    setIsLoading(false);

    // Cleanup on unmount
    return () => {
      setData(null);
      setIsLoading(false);
    };
  }, [params.id]); // Reset when route param changes

  return (
    <motion.div
      {...PAGE_TRANSITION}
      className={clsx(
