 * - clsx for conditional classes
 * - aria-label on icon-only buttons
 */

import React, { useCallback, useMemo } from 'react';
import { clsx } from 'clsx';

// ─── TYPES ───
// Define all props here. Use explicit types. No optional booleans without defaults.

interface [COMPONENT_NAME]Props {
  id: string;
  title: string;
  isActive?: boolean;
  onSelect: (id: string) => void;
  // Add more props as needed
}

// ─── CONSTANTS ───
// File-specific constants only. Shared constants go in utils/constants.ts

const [CONSTANT_NAME] = '[VALUE]' as const;

// ─── HELPER FUNCTIONS ───
// Small, non-exported helpers used only in this component

const [helperName] = (input: string): string => {
  return input.toUpperCase();
};

// ─── COMPONENT ───

const [COMPONENT_NAME]: React.FC<[COMPONENT_NAME]Props> = ({
  id,
  title,
  isActive = false, // ALWAYS provide default for optional booleans
  onSelect,
}) => {
  // Event handlers: ALWAYS use useCallback
  const handleClick = useCallback(() => {
    onSelect(id);
  }, [id, onSelect]);

  // Derived data: ALWAYS use useMemo
  const computedLabel = useMemo(() => {
    return `${title} (${id})`;
  }, [title, id]);

  return (
    <button
      type="button"
      onClick={handleClick}
      aria-pressed={isActive}
      className={clsx(
        // Layout
        'flex items-center',
        // Spacing
        'px-4 py-3 gap-2',
        // Sizing
        'w-full min-h-[44px]',
        // Typography
        'text-sm font-body font-medium',
        // Colors
        'rounded-xl transition-colors duration-200',
        // States
        isActive
          ? 'bg-accent-600 text-white'
          : 'bg-white text-n-700 hover:bg-n-50 active:scale-[0.97]'
      )}
    >
      {computedLabel}
    </button>
  );
};

// ─── SUB-COMPONENTS ───
// Only if small and ONLY used here. Otherwise extract to a separate file.

// const SubComponent: React.FC<SubProps> = ({ ... }) => { ... };

export default [COMPONENT_NAME];
